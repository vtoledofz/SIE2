# Configura los valores reales como variables de entorno de Render; no publiques secretos.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=RENDER_POSTGRES_HOST
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=RENDER_POSTGRES_DB
DB_POSTGRESDB_USER=RENDER_POSTGRES_USER
DB_POSTGRESDB_PASSWORD=RENDER_POSTGRES_PASSWORD
DB_POSTGRESDB_SCHEMA=n8n_data
N8N_ENCRYPTION_KEY=generate-a-long-random-key
N8N_HOST=your-n8n.onrender.com
N8N_PROTOCOL=https
N8N_PORT=10000
PORT=10000
N8N_EDITOR_BASE_URL=https://your-n8n.onrender.com/
N8N_WEBHOOK_URL=https://your-n8n.onrender.com/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
BACKOFFICE_API_URL=https://your-backoffice.onrender.com
BACKOFFICE_API_TOKEN=replace-with-random-secret
APPROVAL_WEBHOOK_TOKEN=replace-with-a-different-random-secret
TELEGRAM_CHAT_ID=replace-with-test-chat-id
