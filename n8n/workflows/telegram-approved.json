      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst caseId = String(body.case_id ?? '').trim();\nconst draft = String(body.draft_message ?? '').trim().slice(0,4000);\nconst valid = body.decision === 'approved' && caseId.length > 0 && draft.length > 0;\nreturn [{json:{...body,case_id:caseId,draft_message:draft,valid}}];"
      },
      "id": "845c05c6-3100-4825-b677-d4593618eee3",
      "name": "Comprueba aprobación",
