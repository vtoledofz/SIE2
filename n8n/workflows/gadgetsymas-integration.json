      "parameters": {"toolDescription": "Guarda una propuesta de soporte en estado pending_review. Nunca envía Telegram. El agente debe proporcionar el JSON de la propuesta.", "method": "POST", "url": "=https://BACKOFFICE_URL/api/incidents/by-external/{{ $('Valida y normaliza').item.json.event.data.case_id }}/proposal", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={{JSON.stringify($fromAI('proposal','JSON con case_type, looked_up, proposed_action, rationale, confidence, priority, warnings, draft_message y final_status','json'))}}", "options": {}},
      "id": "abdf6cc7-dbd6-4c77-9500-87fd5ab7c122", "name": "Herramienta: proponer y guardar borrador", "type": "n8n-nodes-base.httpRequestTool", "typeVersion": 1.2, "position": [820, 90], "credentials": {"httpHeaderAuth": {"id": "00000000-0000-4000-8000-000000000001", "name": "Back-office API Token"}}
