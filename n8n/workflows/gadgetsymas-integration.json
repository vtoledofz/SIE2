      "parameters": {
        "jsCode": "const event = $('Valida y normaliza').item.json.event;\nconst proposal = {case_type:'revision_manual_por_ia_no_disponible', looked_up:{order_and_history:'not_consulted'}, proposed_action:'Derivar a atención humana y revisar la incidencia manualmente.', rationale:'El proveedor Gemini no respondió o alcanzó el límite gratuito; no se reintenta para evitar llamadas innecesarias.', confidence:0, priority:'normal', warnings:['ai_provider_unavailable','quota_or_rate_limit_possible','No se envió mensaje al cliente.'], draft_message:'Servicio de asistencia automatizada temporalmente limitado. Tu consulta queda pendiente para atención humana.', final_status:'pending_review'};\nreturn [{json:{event,proposal}}];"
