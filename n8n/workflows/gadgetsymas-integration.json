      "id": "a1df6cc7-dbd6-4c77-9500-87fd5ab7c112", "name": "Webhook de la tienda", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [-900, 100], "webhookId": "gadgetsymas-events", "credentials": {"httpHeaderAuth": {"id": "00000000-0000-4000-8000-000000000002", "name": "GadgetsY Store Webhook"}}
