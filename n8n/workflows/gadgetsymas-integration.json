      "id": "aadf6cc7-dbd6-4c77-9500-87fd5ab7c121", "name": "Herramienta: consultar pedido e historial", "type": "n8n-nodes-base.httpRequestTool", "typeVersion": 1.2, "position": [650, 90], "credentials": {"httpHeaderAuth": {"id": "00000000-0000-4000-8000-000000000001", "name": "Back-office API Token"}}
