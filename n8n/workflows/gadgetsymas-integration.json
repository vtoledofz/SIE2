    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const event = $('Valida y normaliza').item.json.event;\nconst raw = String($('Agente de incidencias supervisado').item.json.output ?? $('Agente de incidencias supervisado').item.json.text ?? '');\nlet p;\ntry { p = JSON.parse(raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '').trim()); } catch {}\nconst valid = p && typeof p === 'object' && p.case_type && p.proposed_action && p.rationale && typeof p.confidence === 'number' && p.priority && p.draft_message;\nconst proposal = valid ? {case_type:String(p.case_type), looked_up:(p.looked_up && typeof p.looked_up === 'object') ? p.looked_up : {note:'No se devolvieron datos estructurados de consulta'}, proposed_action:String(p.proposed_action), rationale:String(p.rationale), confidence:Math.max(0,Math.min(1,Number(p.confidence))), priority:String(p.priority), warnings:Array.isArray(p.warnings)?p.warnings.map(String):['agent_output_missing_warnings'], draft_message:String(p.draft_message).slice(0,4000), final_status:'pending_review'} : {case_type:'revision_manual_salida_ia_no_estructurada', looked_up:{note:'La respuesta del agente no tenía el formato esperado'}, proposed_action:'Revisar manualmente la incidencia y preparar respuesta.', rationale:'La IA no devolvió una propuesta estructurada válida; se crea una tarea segura para revisión humana.', confidence:0, priority:'normal', warnings:['agent_output_invalid_or_unstructured','No se envió mensaje al cliente.'], draft_message:'La consulta está pendiente de revisión por atención humana.', final_status:'pending_review'};\nreturn [{json:{event,proposal}}];"
