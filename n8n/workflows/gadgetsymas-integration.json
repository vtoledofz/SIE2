    {
      "parameters": {
        "jsCode": "const incoming = $json.body ?? $json;\nconst allowed = ['order.created','payment.stripe_succeeded','inventory.stock_updated','support.requested'];\nconst errors = [];\nif (!incoming.event_id) errors.push('event_id');\nif (!incoming.event_type || !allowed.includes(incoming.event_type)) errors.push('event_type');\nif (!incoming.occurred_at) errors.push('occurred_at');\nif (!incoming.correlation_id) errors.push('correlation_id');\nif (!incoming.data || typeof incoming.data !== 'object') errors.push('data');\nif (incoming.event_type === 'order.created' && incoming.data) { for (const k of ['order_id','order_code','customer_ref','status','currency','total','items']) if (incoming.data[k] === undefined) errors.push(`data.${k}`); if (!Array.isArray(incoming.data.items) || incoming.data.items.length === 0) errors.push('data.items'); }\nif (incoming.event_type === 'support.requested' && incoming.data) { if (!incoming.data.customer_ref) errors.push('data.customer_ref'); if (!String(incoming.data.message ?? '').trim()) errors.push('data.message'); }\nreturn [{json:{valid:errors.length===0, validation_errors:errors, event:incoming}}];"
      },
