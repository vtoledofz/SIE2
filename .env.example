# Copia este archivo como .env; no guardes la copia .env en Git.
# Genera una clave estable de al menos 32 bytes y no la cambies tras crear credenciales n8n.
N8N_ENCRYPTION_KEY=REEMPLAZAR_POR_SECRETO_HEXADECIMAL_LARGO

# Dominio público que apunta a la IP de tu router (DNS/DDNS).
N8N_DOMAIN=n8n.TU-DOMINIO.example
ACME_EMAIL=TU-CORREO@example.com
